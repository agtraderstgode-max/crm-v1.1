# ==============================================================================
# TILES CRM ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=5001

# Supabase Configuration
# Replace these with your new Supabase Project URL and anon / service_role Key
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Storage Mode:
# USE_CLOUD=false -> Local-first (super fast response, syncs to Supabase)
# USE_CLOUD=true  -> Cloud-first (direct Supabase query)
USE_CLOUD=false
